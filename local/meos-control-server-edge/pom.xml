<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>local</artifactId>
        <groupId>com.persagy</groupId>
        <version>5.250501.0</version>
    </parent>

    <artifactId>meos-control-server-edge</artifactId>
    <version>5.250501.0</version>
    <packaging>jar</packaging>
    <description>能源监控接口服务</description>

	<properties>
        <validate-hibernate-starter.version>1.1.1</validate-hibernate-starter.version>
        <validate-ems-hibernate-starter.version>1.1.1</validate-ems-hibernate-starter.version>
	</properties>
	
    <dependencies>

        <dependency>
            <groupId>com.persagy</groupId>
            <artifactId>meos-control-compute-edge</artifactId>
            <version>5.250501.0</version>
        </dependency>

        <!--  自动升级数据库   -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
