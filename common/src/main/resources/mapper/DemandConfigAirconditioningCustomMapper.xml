    <sql id="Base_Column_List">
        id, project_id, demand_instance_type, demand_instance_id, config_data, rel_template_id, rel_scene_id
    </sql>

    <select id="get" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select *
                     , row_number() over (partition by project_id, demand_instance_type, demand_instance_id, rel_template_id
                    order by valid_end_time desc) as rowNumber
                from demand_config_airconditioning_custom_snapshot
                <where>
                    <include refid="DemandConfigAirconditioningQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1
                limit 1;
            </when>
            <otherwise>
                select
                <include refid="Base_Column_List"/>
                from demand_config_airconditioning_custom
                <where>
                    <include refid="DemandConfigAirconditioningQueryDaoParam"/>
                </where>
                limit 1
            </otherwise>
        </choose>
    </select>

    <select id="list" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select *
                     , row_number() over (partition by project_id, demand_instance_type, demand_instance_id, rel_template_id
                    order by valid_end_time desc) as rowNumber
                from demand_config_airconditioning_custom_snapshot
                <where>
                    <include refid="DemandConfigAirconditioningQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1;
            </when>
            <otherwise>
                select
                <include refid="Base_Column_List"/>
                from demand_config_airconditioning_custom
                <where>
                    <include refid="DemandConfigAirconditioningQueryDaoParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <sql id="DemandConfigAirconditioningQueryDaoParam">
        <!--@sql select * from demand_config_airconditioning_custom where -->
        <if test="param.id != null">
            id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.projectId != null and param.projectId != ''">
            and project_id = #{param.projectId}
        </if>
        <if test="param.demandInstanceType != null">
            and demand_instance_type = #{param.demandInstanceType}
        </if>
        <if test="param.demandInstanceTypes != null and param.demandInstanceTypes.size() != 0">
            and demand_instance_type in
            <foreach collection="param.demandInstanceTypes" item="demandInstanceType" open="(" separator="," close=")">
                #{demandInstanceType}
            </foreach>
        </if>
        <if test="param.demandInstanceId != null and param.demandInstanceId != ''">
            and demand_instance_id = #{param.demandInstanceId}
        </if>
        <if test="param.demandInstanceIds != null and param.demandInstanceIds.size() != 0">
            and demand_instance_id in
            <foreach collection="param.demandInstanceIds" item="demandInstanceId" open="(" separator="," close=")">
                #{demandInstanceId}
            </foreach>
        </if>
        <if test="param.relTemplateId != null">
            and rel_template_id = #{param.relTemplateId}
        </if>
        <if test="param.relTemplateIds != null and param.relTemplateIds.size() != 0">
            and rel_template_id in
            <foreach collection="param.relTemplateIds" item="relTemplateId" open="(" separator="," close=")">
                #{relTemplateId}
            </foreach>
        </if>
    </sql>

    <select id="queryFixDataList" resultMap="TimeGroupResultMap">
        SELECT id,
        rel_template_id,
        config_data,
        project_id,
        valid_end_time  AS max_valid_end_time
        from demand_config_airconditioning_custom_snapshot
        where rel_template_id in (SELECT id from demand_template_snapshot)
        and valid_end_time &lt;= "2025-02-21"
        order by valid_end_time;
    </select>

    <select id="querySnapshotByDemandTemplateId" resultMap="TimeGroupResultMap">
        SELECT id,
               rel_template_id,
               config_data,
               project_id,
               DATE(valid_end_time) AS date_group,
               MAX(valid_end_time)  AS max_valid_end_time
        from demand_config_airconditioning_custom_snapshot
        where rel_template_id in (SELECT id from demand_template_snapshot)
          and valid_end_time &lt; NOW()
        GROUP BY DATE(valid_end_time), rel_template_id, project_id;
    </select>
    <select id="queryTimeScopeFixDataList" resultMap="TimeGroupResultMap">
    <![CDATA[
        SELECT id,
               rel_template_id,
               config_data,
               project_id,
               demand_instance_type,
               demand_instance_id,
               update_time,
               valid_end_time AS max_valid_end_time
        from demand_config_airconditioning_custom_snapshot
        where project_id = #{projectId}
          and update_time <= #{endDate}
          AND valid_end_time >= #{startDate}
        ]]>
</select>

    <update id="updateDemandConfigAirconditioningCustomTimeGroup">
        update demand_config_airconditioning_custom_snapshot
        set config_data = #{configData, jdbcType=LONGVARCHAR, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler}
        where id = #{id} and valid_end_time = #{maxValidEndTime}
    </update>

    <delete id="deleteSnapshotByAllValueSelect">
        delete
        from demand_config_airconditioning_custom_snapshot
        where rel_template_id in
              ('value_select_lowest_energy', 'value_select_lowest_cast', 'value_select_Lowest_carbon_emissions',
               'value_select_quality_first')
    </delete>
