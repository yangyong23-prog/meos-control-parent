<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.demand.DemandInstanceConfigMapper">
    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.demand.DemandInstanceConfig">
        <!--@mbg.generated-->
        <!--@Table demand_instance_config-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="project_id" jdbcType="VARCHAR" property="projectId"/>
        <result column="demand_type" jdbcType="VARCHAR" property="demandType"/>
        <result column="demand_template_type" jdbcType="VARCHAR" property="demandTemplateType"/>
        <result column="demand_instance_type" jdbcType="VARCHAR" property="demandInstanceType"/>
        <result column="demand_instance_id" jdbcType="VARCHAR" property="demandInstanceId"/>
        <result column="config_data" jdbcType="VARCHAR" property="configData"/>
        <result column="st" jdbcType="VARCHAR" property="st"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="create_user" jdbcType="VARCHAR" property="createUser"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="update_user" jdbcType="VARCHAR" property="updateUser"/>
    </resultMap>

    <select id="count" resultType="int">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select count(*) from (
                select id,
                       row_number() over (partition by project_id, demand_type, demand_template_type, demand_instance_type, demand_instance_id, st order by valid_end_time desc) as rowNumber
                from demand_instance_config_snapshot
                <where>
                    <include refid="DemandInstanceConfigQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1;
            </when>
            <otherwise>
                select count(*)
                from demand_instance_config
                <where>
                    <include refid="DemandInstanceConfigQueryDaoParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <select id="list" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                , row_number() over (partition by project_id, demand_type, demand_template_type, demand_instance_type, demand_instance_id, st order by valid_end_time desc) as rowNumber
                from demand_instance_config_snapshot
                <where>
                    <include refid="DemandInstanceConfigQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1;
            </when>
            <otherwise>
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                from demand_instance_config
                <where>
                    <include refid="DemandInstanceConfigQueryDaoParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <sql id="DemandInstanceConfigQueryDaoParam">
        <!--@sql select * from demand_instance_config_snapshot where -->
        project_id = #{projectId}
        <if test="param.id != null">
            and id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.demandType != null">
            and demand_type = #{param.demandType}
        </if>
        <if test="param.demandTemplateType != null">
            and demand_template_type = #{param.demandTemplateType}
        </if>
        <if test="param.demandInstanceType != null">
            and demand_instance_type = #{param.demandInstanceType}
        </if>
        <if test="param.demandInstanceTypes != null and param.demandInstanceTypes.size() != 0">
            and demand_instance_type in
            <foreach collection="param.demandInstanceTypes" item="demandInstanceType" open="(" separator="," close=")">
                #{demandInstanceType}
            </foreach>
        </if>
        <if test="param.demandInstanceId != null and param.demandInstanceId != ''">
            and demand_instance_id = #{param.demandInstanceId}
        </if>
        <if test="param.demandInstanceIds != null and param.demandInstanceIds.size() != 0">
            and demand_instance_id in
            <foreach collection="param.demandInstanceIds" item="demandInstanceId" open="(" separator="," close=")">
                #{demandInstanceId}
            </foreach>
        </if>
        <if test="param.shielded != null || param.inBlacklisted != null">
            and (
            <if test="param.shielded != null">
                convert(json_extract(config_data, '$.shielded'), signed) = #{param.shielded}
            </if>
            <if test="param.inBlacklisted != null">
                <if test="param.shielded != null">
                    or
                </if>
                convert(json_extract(config_data, '$.inBlacklisted'), signed) = #{param.inBlacklisted}
            </if>
            )
        </if>
        <if test="param.st != null">
            and st = #{param.st}
        </if>
    </sql>
</mapper>