<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.demand.DemandTemplateMapper">
    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.demand.DemandTemplate">
        <!--@mbg.generated-->
        <!--@Table demand_template-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="project_id" jdbcType="VARCHAR" property="projectId"/>
        <result column="demand_type" jdbcType="VARCHAR" property="demandType"/>
        <result column="demand_template_type" jdbcType="VARCHAR" property="demandTemplateType"/>
        <result column="demand_template_tag" jdbcType="VARCHAR" property="demandTemplateTag"/>
        <result column="demand_template_name" jdbcType="VARCHAR" property="demandTemplateName"/>
        <result column="is_initialized" jdbcType="BOOLEAN" property="isInitialized"/>
        <result column="is_enabled" jdbcType="BOOLEAN" property="isEnabled"/>
        <result column="st" jdbcType="VARCHAR" property="st"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="create_user" jdbcType="VARCHAR" property="createUser"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="update_user" jdbcType="VARCHAR" property="updateUser"/>
    </resultMap>

    <select id="list" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                , row_number() over (partition by project_id, demand_type, demand_template_type, demand_template_tag, demand_template_name order by valid_end_time desc) as rowNumber
                from demand_template_snapshot
                <where>
                    <include refid="DemandTemplateQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1;
            </when>
            <otherwise>
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                from demand_template
                <where>
                    <include refid="DemandTemplateQueryDaoParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <update id="edit" parameterType="com.persagy.apccontrol.basic.resource.demand.param.DemandTemplateUpdateDaoParam">
        update demand_template
        <set>
            <if test="param.demandType != null">
                demand_type = '${param.demandType.value()}'
            </if>
            <if test="param.demandTemplateType != null">
                , demand_template_type = '${param.demandTemplateType.value()}'
            </if>
            <if test="param.demandTemplateTag != null and param.demandTemplateTag != ''">
                , demand_template_tag = #{param.demandTemplateTag}
            </if>
            <if test="param.demandTemplateName != null and param.demandTemplateName != ''">
                , demand_template_name = #{param.demandTemplateName}
            </if>
            <if test="param.isInitialized != null">
                , is_initialized = #{param.isInitialized}
            </if>
            <if test="param.isEnabled != null">
                , is_enabled = #{param.isEnabled}
            </if>
            <if test="param.st != null">
                , st = #{param.st}
            </if>
        </set>
        where id = #{param.id}
    </update>

    <sql id="DemandTemplateQueryDaoParam">
        <!--@sql select * from demand_template_snapshot where -->
        project_id = #{projectId}
        <if test="param.id != null">
            and id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.demandType != null">
            and demand_type = #{param.demandType}
        </if>
        <if test="param.demandTemplateType != null">
            and demand_template_type = #{param.demandTemplateType}
        </if>
        <if test="param.demandTemplateTag != null and param.demandTemplateTag != ''">
            and demand_template_tag = #{param.demandTemplateTag}
        </if>
        <if test="param.demandTemplateTags != null and param.demandTemplateTags.size() != 0">
            and demand_template_tag in
            <foreach collection="param.demandTemplateTags" item="demandTemplateTag" open="(" separator="," close=")">
                #{demandTemplateTag}
            </foreach>
        </if>
        <if test="param.isInitialized != null">
            and is_initialized = #{param.isInitialized}
        </if>
        <if test="param.isEnabled != null">
            and is_enabled = #{param.isEnabled}
        </if>
        <if test="param.st != null">
            and st = #{param.st}
        </if>
    </sql>
</mapper>