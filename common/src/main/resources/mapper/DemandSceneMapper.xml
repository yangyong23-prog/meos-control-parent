<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.demand.DemandSceneMapper">
    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.demand.DemandScene">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="demand_template_type" property="demandTemplateType"/>
        <result column="demand_template_Tag" property="demandTemplateTag"/>
        <result column="scene_name" property="sceneName"/>
        <result column="begin_time" property="beginTime"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="end_time" property="endTime"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="sequence" property="sequence"/>
        <result column="rel_template_id" property="relTemplateId"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user" property="updateUser"/>
    </resultMap>

    <select id="list" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                , row_number() over (partition by project_id, demand_template_type, demand_template_Tag, begin_time, end_time order by valid_end_time desc) as rowNumber
                from demand_scene_snapshot
                <where>
                    <include refid="DemandSceneQueryDaoParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1;
            </when>
            <otherwise>
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                from demand_scene
                <where>
                    <include refid="DemandSceneQueryDaoParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <sql id="DemandSceneQueryDaoParam">
        <!--@sql select * from demand_scene_snapshot where -->
        project_id = #{projectId}
        <if test="param.id != null">
            and id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.relTemplateId != null">
            and rel_template_id = #{param.relTemplateId}
        </if>
        <if test="param.relTemplateIds != null and param.relTemplateIds.size() != 0">
            and rel_template_id in
            <foreach collection="param.relTemplateIds" item="relTemplateId" open="(" separator="," close=")">
                #{relTemplateId}
            </foreach>
        </if>
    </sql>
</mapper>