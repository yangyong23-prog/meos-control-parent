        ordered,
        parameter_type,
        extend_info,
        create_time,
        sys_time,
        system_id,
        group_info,
        enum
        )
        VALUES
        <foreach collection="listCfg" separator="," item="listCfg">
            (
            #{listCfg.id},
            #{listCfg.projectId},
            #{listCfg.equipmentId},
            #{listCfg.classCode},
            #{listCfg.infoCode},
            #{listCfg.name},
            #{listCfg.alias},
            #{listCfg.unit},
            #{listCfg.scale},
            #{listCfg.displayPosition},
            #{listCfg.max},
            #{listCfg.min},
            #{listCfg.ordered},
            #{listCfg.parameterType},
            #{listCfg.extendInfo},
            #{listCfg.createTime},
            #{listCfg.sysTime},
            #{listCfg.systemId},
            #{listCfg.groupInfo},
            #{listCfg.enumTpye}
