<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.demand.DemandConfigResultMapper">

    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.demand.DemandConfigResult">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="demand_template_type" property="demandTemplateType"/>
        <result column="demand_instance_type" property="demandInstanceType"/>
        <result column="demand_instance_id" property="demandInstanceId"/>
        <result column="final_config_json" property="finalConfigJson"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="is_customized_config" property="isCustomizedConfig"/>
        <result column="is_shielded" property="isShielded"/>
        <result column="inherit_instances_json" property="inheritInstancesJson"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="rel_template_id" property="relTemplateId"/>
        <result column="rel_scene_id" property="relSceneId"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user" property="updateUser"/>
    </resultMap>

    <select id="list" resultMap="BaseResultMap">
        <choose>
            <when test="param.date != null and param.date.isBefore(@java.time.LocalDate@now())">
                select * from (
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                , row_number() over (partition by project_id, demand_template_type, demand_instance_type, demand_instance_id, rel_template_id, rel_scene_id order by valid_end_time desc) as rowNumber
                from demand_config_result_snapshot
                <where>
                    <include refid="DemandConfigResultRepositoryQueryParam"/>
                    and date(update_time) &lt;= #{param.date}
                    and date(valid_end_time) &gt; #{param.date}
                </where>
                ) as window_function
                where rowNumber = 1
            </when>
            <otherwise>
                select
                <choose>
                    <when test="withColumns != null and withColumns.length != 0">
                        <foreach collection="withColumns" item="withColumn" separator=",">
                            ${withColumn}
                        </foreach>
                    </when>
                    <otherwise>
                        *
                    </otherwise>
                </choose>
                from demand_config_result
                <where>
                    <include refid="DemandConfigResultRepositoryQueryParam"/>
                </where>
            </otherwise>
        </choose>
    </select>

    <select id="listIds" resultType="java.lang.Long">
        select id
        from demand_config_result
        <where>
            <include refid="DemandConfigResultRepositoryQueryParam"/>
        </where>
        order by id
        limit #{limit}
    </select>

    <insert id="insertBatch">
        insert into demand_config_result
        (
        id,
        project_id,
        demand_template_type,
        demand_instance_type,
        demand_instance_id,
        final_config_json,
        is_customized_config,
        is_shielded,
        inherit_instances_json,
        rel_template_id,
        rel_scene_id,
        create_time,
        create_user,
        update_time,
        update_user
        )
        values
        <foreach collection="results" item="result" separator=",">
            (
            #{result.id},
            #{result.projectId},
            #{result.demandTemplateType},
            #{result.demandInstanceType},
            #{result.demandInstanceId},
            #{result.finalConfigJson,
            typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler},
            #{result.isCustomizedConfig},
            #{result.isShielded},
            #{result.inheritInstancesJson,
            typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler},
            #{result.relTemplateId},
            #{result.relSceneId},
            #{result.createTime},
            #{result.createUser},
            #{result.updateTime},
            #{result.updateUser}
            )
        </foreach>
    </insert>

    <sql id="DemandConfigResultRepositoryQueryParam">
        project_id = #{projectId}
        <if test="param.id != null">
            and id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.demandTemplateType != null">
            and demand_template_type = #{param.demandTemplateType}
        </if>
        <if test="param.demandTemplateTypes != null and param.demandTemplateTypes.size() != 0">
            and demand_template_type in
            <foreach collection="param.demandTemplateTypes" item="demandTemplateType" open="(" separator="," close=")">
                #{demandTemplateType}
            </foreach>
        </if>
        <if test="param.demandInstanceType != null">
            and demand_instance_type = #{param.demandInstanceType}
        </if>
        <if test="param.demandInstanceTypes != null and param.demandInstanceTypes.size() != 0">
            and demand_instance_type in
            <foreach collection="param.demandInstanceTypes" item="demandInstanceType" open="(" separator="," close=")">
                #{demandInstanceType}
            </foreach>
        </if>
        <if test="param.demandInstanceId != null">
            and demand_instance_id = #{param.demandInstanceId}
        </if>
        <if test="param.demandInstanceIds != null and param.demandInstanceIds.size() != 0">
            and demand_instance_id in
            <foreach collection="param.demandInstanceIds" item="demandInstanceId" open="(" separator="," close=")">
                #{demandInstanceId}
            </foreach>
        </if>
        <if test="param.instanceTypeAndInstanceIds != null and param.instanceTypeAndInstanceIds.size() != 0">
            and
            <foreach collection="param.instanceTypeAndInstanceIds" index="key" item="instanceIds" open="("
                     separator="or" close=")">
                demand_instance_type = #{key}
                <if test="instanceIds != null and instanceIds.size() != 0">
                    and demand_instance_id in
                    <foreach collection="instanceIds" item="instanceId" open="(" separator="," close=")">
                        #{instanceId}
                    </foreach>
                </if>
            </foreach>
        </if>
        <if test="param.relTemplateId != null">
            and rel_template_id = #{param.relTemplateId}
        </if>
        <if test="param.relTemplateIds != null and param.relTemplateIds.size() != 0">
            and rel_template_id in
            <foreach collection="param.relTemplateIds" item="relTemplateId" open="(" separator="," close=")">
                #{relTemplateId}
            </foreach>
        </if>
        <if test="param.relSceneId != null">
            and rel_scene_id = #{param.relSceneId}
        </if>
        <if test="param.relSceneIds != null and param.relSceneIds.size() != 0">
            and rel_scene_id in
            <foreach collection="param.relSceneIds" item="relSceneId" open="(" separator="," close=")">
                #{relSceneId}
            </foreach>
        </if>
        <if test="param.relSceneIdIsNull != null and param.relSceneIdIsNull and param.relSceneId == null
                and (param.relSceneIds == null or param.relSceneIds.size() == 0)">
            and rel_scene_id is null
        </if>
        <if test="param.isShielded != null">
            and is_shielded = #{param.isShielded}
        </if>
        <if test="param.businessKeys != null and param.businessKeys.size() != 0">
            and
            <foreach collection="param.businessKeys" item="businessKey" open="(" separator="or" close=")">
                (
                rel_template_id = #{businessKey.relTemplateId}
                <choose>
                    <when test="businessKey.relSceneId != null">
                        and rel_scene_id = #{businessKey.relSceneId}
                    </when>
                    <otherwise>
                        and rel_scene_id is null
                    </otherwise>
                </choose>
                <if test="businessKey.demandTemplateType != null">
                    and demand_template_type = #{businessKey.demandTemplateType}
                </if>
                and demand_instance_type = #{businessKey.demandInstanceType}
                and demand_instance_id = #{businessKey.demandInstanceId}
                )
            </foreach>
        </if>
    </sql>
</mapper>
