<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.cache.CacheTemplateObjectDetailMapper">

    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.cache.CacheTemplateObjectDetail">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="template_key" property="templateKey"/>
        <result column="object_id" property="objectId"/>
        <result column="info_code" property="infoCode"/>
        <result column="result_json" property="resultJson"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user" property="updateUser"/>
    </resultMap>

    <select id="listByBusinessKeys" resultMap="BaseResultMap">
        select
        <include refid="SelectColumns"/>
        from cache_template_object_detail
        where project_id = #{projectId}
        and
        (
        <!-- Service 保证业务键非空；分组字段顺序匹配 idx_template_object_info，并避免独立 IN 组合误命中。 -->
        <foreach collection="param.businessKeys" item="businessKey" separator=" or ">
            (
            template_key = #{businessKey.templateKey}
            and object_id = #{businessKey.objectId}
            and info_code = #{businessKey.infoCode}
            )
        </foreach>
        )
    </select>

    <insert id="insertBatch">
        insert into cache_template_object_detail
        (
        id,
        project_id,
        template_key,
        object_id,
        info_code,
        result_json,
        create_time,
        create_user,
        update_time,
        update_user
        )
        values
        <foreach collection="details" item="detail" separator=",">
            (
            #{detail.id},
            #{detail.projectId},
            #{detail.templateKey},
            #{detail.objectId},
            #{detail.infoCode},
            #{detail.resultJson},
            #{detail.createTime},
            #{detail.createUser},
            #{detail.updateTime},
            #{detail.updateUser}
            )
        </foreach>
    </insert>

    <delete id="deleteByTemplateKey">
        delete from cache_template_object_detail
        where project_id = #{projectId}
        and template_key = #{templateKey}
    </delete>

    <sql id="SelectColumns">
        <choose>
            <when test="withColumns != null and withColumns.length != 0">
                <foreach collection="withColumns" item="withColumn" separator=",">
                    ${withColumn}
                </foreach>
            </when>
            <otherwise>
                *
            </otherwise>
        </choose>
    </sql>
</mapper>
