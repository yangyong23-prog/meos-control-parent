    <!--suppress checkSelectColumnExistInMybatisResultmap -->
    <select id="get" resultMap="BaseResultMap">
        select *
        from strategy_cfg
        <where>
            <include refid="StrategyCfgQueryDaoParam"/>
        </where>
    </select>

    <select id="listIds" resultType="java.lang.Long">
        select id
        from strategy_cfg
        <where>
            <include refid="StrategyCfgQueryDaoParam"/>
        </where>
    </select>

    <select id="list" resultMap="BaseResultMap">
        select *
        from strategy_cfg
        <where>
            <include refid="StrategyCfgQueryDaoParam"/>
        </where>
    </select>

    <select id="listNotSynced" resultMap="BaseResultMap">
        select *
        from strategy_cfg
        <where>
            <include refid="StrategyCfgQueryDaoParam"/>
            and (sync_time is null or update_time &gt; sync_time)
            limit 100
        </where>
    </select>

    <sql id="StrategyCfgQueryDaoParam">
        <!--@sql select * from strategy_cfg where -->
        <if test="param.projectId != null">
            project_id = #{param.projectId}
        </if>
        <if test="param.systemType != null">
            and system_type = #{param.systemType}
        </if>
        <if test="param.systemId != null and param.systemId != ''">
            and system_id = #{param.systemId}
        </if>
        <if test="param.businessType != null">
            and business_type = #{param.businessType}
        </if>
        <if test="param.strategyType != null">
            and strategy_type = #{param.strategyType}
        </if>
        <if test="param.objectId != null and param.objectId != ''">
            and object_id = #{param.objectId}
        </if>
        <if test="param.status != null">
