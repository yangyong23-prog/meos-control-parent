<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persagy.apccontrol.basic.mapper.demand.DemandTemplateCalendarMapper">
    <resultMap id="BaseResultMap" type="com.persagy.apccontrol.basic.model.entity.demand.DemandTemplateCalendar">
        <!--@mbg.generated-->
        <!--@Table demand_template_calendar-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="project_id" jdbcType="VARCHAR" property="projectId"/>
        <result column="demand_type" jdbcType="VARCHAR" property="demandType"/>
        <result column="demand_template_type" jdbcType="VARCHAR" property="demandTemplateType"/>
        <result column="work_date" jdbcType="DATE" property="workDate"/>
        <result column="is_customized_setting" jdbcType="BOOLEAN" property="isCustomizedSetting"/>
        <result column="rel_demand_template_id" jdbcType="BIGINT" property="relDemandTemplateId"/>
        <result column="st" jdbcType="VARCHAR" property="st"/>
