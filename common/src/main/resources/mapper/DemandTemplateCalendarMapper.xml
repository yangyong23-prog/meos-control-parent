        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="update_user" jdbcType="VARCHAR" property="updateUser"/>
    </resultMap>

    <select id="get" resultMap="BaseResultMap">
        select *
        from demand_template_calendar
        <where>
            <include refid="DemandTemplateCalendarQueryDaoParam"/>
        </where>
    </select>

    <select id="list" resultMap="BaseResultMap">
        select *
        from demand_template_calendar
        <where>
            <include refid="DemandTemplateCalendarQueryDaoParam"/>
        </where>
    </select>

    <sql id="DemandTemplateCalendarQueryDaoParam">
        <!--@sql select * from demand_template_calendar where -->
        <if test="param.id != null">
            id = #{param.id}
        </if>
        <if test="param.ids != null and param.ids.size() != 0">
            and id in
            <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="param.projectId != null and param.projectId != ''">
            and project_id = #{param.projectId}
        </if>
        <if test="param.demandType != null">
            and demand_type = #{param.demandType}
        </if>
        <if test="param.demandTemplateType != null">
            and demand_template_type = #{param.demandTemplateType}
        </if>
        <if test="param.workDate != null">
            and work_date = #{param.workDate}
        </if>
        <if test="param.workDates != null and param.workDates.size() != 0">
            and work_date in
            <foreach collection="param.workDates" item="workDate" open="(" separator="," close=")">
                #{workDate}
            </foreach>
        </if>
        <if test="param.workDateRange != null">
            <if test="param.workDateRange.left != null">
                and #{param.workDateRange.left} &lt;= work_date
            </if>
            <if test="param.workDateRange.right != null">
                and work_date &lt; #{param.workDateRange.right}
            </if>
        </if>
        <if test="param.isCustomizedSetting != null">
            and is_customized_setting = #{param.isCustomizedSetting}
        </if>
        <if test="param.relDemandTemplateId != null">
            and rel_demand_template_id = #{param.relDemandTemplateId}
        </if>
        <if test="param.relDemandTemplateIds != null and param.relDemandTemplateIds.size() != 0">
            and rel_demand_template_id in
            <foreach collection="param.relDemandTemplateIds"
                     item="relDemandTemplateId" open="(" separator="," close=")">
                #{relDemandTemplateId}
            </foreach>
        </if>
        <if test="param.st != null">
            and st = #{param.st}
        </if>
    </sql>
</mapper>