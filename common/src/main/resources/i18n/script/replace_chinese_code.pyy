import os
import re
import uuid
import json

# 定义匹配中文字符串的正则表达式（包含一个中文字符就算）
chinese_pattern = re.compile(r'"[^"]*[\u4e00-\u9fa5]+[^"]*"')

# 定义注释的正则表达式
comment_pattern = re.compile(r'//.*?$|/\*.*?\*/', re.DOTALL | re.MULTILINE)

log_special_pattern = re.compile(r'(ControlLogUtil|LOGGER|log|logger|System\.out|System\.err)\.(info|debug|warn|error|println)\(("[^"]*"|\S+)(,\s*("[^"]*"|\S+))*\);')

# 定义日志语句的正则表达式（根据项目日志框架调整）
log_pattern = re.compile(r'(ControlLogUtil|LOGGER|log|logger|System\.out|System\.err)\.(info|debug|warn|error|println)\([^)]*\)+;')

log_debug_special_pattern = re.compile(r'(ControlLogUtil|LOGGER|log|logger|System\.out|System\.err)\.(info|debug|warn|error|println)\(\s*\"(.*?)\"\s*(?:\+\s*\"(.*?)\")*\s*\);')

log_debug_some_comma_pattern = re.compile(r'(ControlLogUtil|LOGGER|log|logger|System\.out|System\.err)\.(info|debug|warn|error|println)\(\s*\"(.*?)\"\s*(?:,\s*(.*?))?\s*\);')

# swagger数据特殊过滤
swagger_special_tag_pattern = re.compile(r'@(ApiOperation|ApiModel|ApiModelProperty|ApiParam|Api|Operation)\s*\(\s*value\s*=\s*".*?",\s*tags\s*=\s*\{?.*?\}?\s*\)')

swagger_special_top_tag_pattern = re.compile(r'@(Tag)\s*\(\s*name\s*=\s*"*.*?"*,*\s*(description)*\s*(=*)\s*\{?.*?\}?\s*\)')

swagger_special_schema_pattern = re.compile(r'@(Schema)\s*\((\s*(?:title|description|name)\s*=\s*".*?"\s*)(?:,\s*(?:required|accessMode)\s*=\s*\{?.*?\}?\s*)?\)')

# swagger数据特殊过滤
swagger_special_pattern = re.compile(r'@(ApiOperation|ApiModel|ApiModelProperty|ApiParam|Api)\s*\(\s*value\s*=\s*".*?"\s*\)')

# swagger数据特殊过滤
swagger_special_no_value_pattern = re.compile(r'@(ApiOperation|ApiModel|ApiModelProperty|ApiParam|Api)\s*\(\s*".*?"\s*\)')

# swagger数据过滤
swagger_pattern = re.compile(r'@(ApiOperation|ApiModel|ApiModelProperty|ApiParam|Api|ApiSupport|ApiImplicitParam|Operation|RequestParam|Excel)\([^)]*\)')

#自定义规则过滤
custom_special_pattern = re.compile(r'(StopWatch|LogExecutor|logInstance|TenantTask\.log|TenantTask\.logInfo|stopWatch\.start|TenantTask\.logError|saveDrop)\([^,]+, "[^"]*", [^,]+.*, [^)]+\)+;')

custom_special_no_brackets_pattern = re.compile(r'(TenantTask\.log|saveDrop)\([^,]+, .*\);')

#自定义规则过滤
custom_common_pattern = re.compile(r'(logInstance|logProjectInstance|printStackTraceFormat|TenantTask\.log|TenantTask\.logInfo|stopWatch\.start|TenantTask\.logError|watch0\.start|watch\.start|saveDrop|LogTimeUtils\.startWatch|errorLogHandler\.accept|LOG_TAG)\(([^)]*?)\)[^;]*?;')

xxljob_custom_common_pattern = re.compile(r'(XxlJobHelper\.handleFail|XxlJobHelper\.log)\(([^)]*\))+;')

custom_common_has_brackets_pattern = re.compile(r'(XxlJobHelper\.log)\(\s*"([^"]*)"\s*,\s*(.*?)\s*\);')

xxljob_special_pattern = re.compile(r'@(XxlRegister)\s*\(\s*cron\s*=\s*".*?",\s*jobDesc\s*=\s*\{?.*?\}?\s*\)')

#spring特殊过滤
spring_pattern = re.compile(r'(@Value)\([^)]*\)')

custom_common_start = re.compile(r'(StopWatch|logProjectInstance｜LogExecutor|LOG_TAG|logTag|DailyStringCounter|log)[\s\S]*?;')

